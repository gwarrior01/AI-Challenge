# Адрес LLM API (OpenAI-совместимый эндпоинт), без /chat/completions на конце
# Примеры: https://api.openai.com/v1, http://localhost:11434/v1 (Ollama), http://localhost:1234/v1 (LM Studio)
LLM_API_URL=https://api.openai.com/v1

# Ключ API
LLM_API_KEY=sk-...

# Необязательно: модель (по умолчанию gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# Необязательно: отдельная модель для анализа решений во вкладке "Задача · 4 способа"
# веб-интерфейса (кнопка "Проверить решения моделью"). Если не задана — используется LLM_MODEL.
# LLM_ANALYSIS_MODEL=gpt-4o

# Необязательно: размер контекстного окна модели в токенах — используется в интерфейсе
# для индикатора заполнения контекста. Узнать реальный лимит модели через API негде
# (OpenAI-совместимый chat/completions не сообщает его в ответе), поэтому указывайте
# точное значение для своей модели явно. Если не задано — интерфейс считает контекст
# равным 262000 токенов.
# LLM_CONTEXT_WINDOW=128000

# Необязательно: сколько сообщений пользователя накапливать между пересчётами сводки
# при включённом управлении контекстом (сжатие диалога в сводку у агентов и в обычном
# чате). Если не задано — используется 10.
# LLM_CONTEXT_SUMMARY_CHUNK=10

# Необязательно: сколько последних сообщений пользователя держат именованные агенты
# при стратегии контекста sliding-window/facts. Если не задано — используется 6.
# LLM_SLIDING_WINDOW_SIZE=6

# Необязательно: подсчёт стоимости запросов именованных агентов по расходу токенов —
# работает, только если заданы ОБЕ переменные (цена за 1 000 000 входных/выходных
# токенов). Если не заданы — стоимость нигде не считается и не показывается.
# LLM_PRICE_INPUT_PER_1M=3
# LLM_PRICE_OUTPUT_PER_1M=15

# Необязательно: валюта для сумм из LLM_PRICE_*_PER_1M выше. Если не задано — "$".
# LLM_PRICE_CURRENCY=$

# Необязательно: путь к файлу конфигурации MCP-серверов (см. mcp.example.json).
# Если не задано — mcp.json в текущей рабочей директории; нет файла — MCP не используется.
# LLM_MCP_CONFIG=mcp.json

# Индекс документов для RAG (llm-cli rag …, экран F6 в TUI).
# Обязательно для индексации и поиска: модель эмбеддингов. Значения по умолчанию нет —
# векторы разных моделей несравнимы, индекс запоминает свою модель.
# LLM_EMBEDDING_MODEL=text-embedding-bge-m3

# Необязательно: адрес и ключ API эмбеддингов, если не те же, что у чата (LLM_API_URL/LLM_API_KEY).
# LLM_EMBEDDING_API_URL=http://localhost:1234/v1
# LLM_EMBEDDING_API_KEY=lm-studio

# Необязательно: сколько текстов отправлять в одном запросе /embeddings (по умолчанию 32).
# LLM_EMBEDDING_BATCH=32

# Необязательно: префиксы для моделей, которые их ждут (nomic: "search_document: " / "search_query: ",
# e5: "passage: " / "query: "). bge-m3 префиксы не нужны.
# LLM_EMBEDDING_DOC_PREFIX=
# LLM_EMBEDDING_QUERY_PREFIX=

# Необязательно: корпус (файлы и папки через запятую), файл индекса, контрольные вопросы и отчёт сравнения.
# По умолчанию корпус пуст — индексируются только загрузки (RAG_UPLOADS).
# Корпус проекта, на котором сравнивались стратегии (rag/compare.md):
# RAG_CORPUS=README.md,core/src,mcp,invariants,profiles,documents/inbox
# RAG_DB_PATH=rag/index.db
# RAG_EVAL=rag/eval.json
# RAG_REPORT=rag/compare.md
# Папка загруженных документов (веб-вкладка «RAG», команда add) — всегда часть корпуса.
# RAG_UPLOADS=rag/uploads

# Модель решений Jev (TypeSafe) через OpenRouter Decisions API — экран F7 в TUI, вкладка «Jev» в вебе.
# Ключ OpenRouter (нужны предоплаченные кредиты). Если не задан — берётся OPENROUTER_API_KEY,
# а если LLM_API_URL указывает на openrouter.ai — LLM_API_KEY.
# JEV_API_KEY=sk-or-...
# Необязательно: адрес эндпоинта и модель (значения по умолчанию ниже).
# JEV_API_URL=https://openrouter.ai/api/alpha/decisions
# JEV_MODEL=typesafe/jev-1.13
