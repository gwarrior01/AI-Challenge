# Адрес LLM API (OpenAI-совместимый эндпоинт), без /chat/completions на конце
# Примеры: https://api.openai.com/v1, http://localhost:11434/v1 (Ollama), http://localhost:1234/v1 (LM Studio)
LLM_API_URL=https://api.openai.com/v1

# Ключ API
LLM_API_KEY=sk-...

# Необязательно: модель (по умолчанию gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# Необязательно: отдельная модель для анализа решений во вкладке "Задача · 4 способа"
# веб-интерфейса (кнопка "Проверить решения моделью"). Если не задана — используется LLM_MODEL.
# LLM_ANALYSIS_MODEL=gpt-4o

# Необязательно: размер контекстного окна модели в токенах — используется в интерфейсе
# для индикатора заполнения контекста. Узнать реальный лимит модели через API негде
# (OpenAI-совместимый chat/completions не сообщает его в ответе), поэтому указывайте
# точное значение для своей модели явно. Если не задано — интерфейс считает контекст
# равным 262000 токенов.
# LLM_CONTEXT_WINDOW=128000

# Необязательно: сколько сообщений пользователя накапливать между пересчётами сводки
# при включённом управлении контекстом (сжатие диалога в сводку у агентов и в обычном
# чате). Если не задано — используется 10.
# LLM_CONTEXT_SUMMARY_CHUNK=10

# Необязательно: сколько последних сообщений пользователя держат именованные агенты
# при стратегии контекста sliding-window/facts. Если не задано — используется 6.
# LLM_SLIDING_WINDOW_SIZE=6

# Необязательно: подсчёт стоимости запросов именованных агентов по расходу токенов —
# работает, только если заданы ОБЕ переменные (цена за 1 000 000 входных/выходных
# токенов). Если не заданы — стоимость нигде не считается и не показывается.
# LLM_PRICE_INPUT_PER_1M=3
# LLM_PRICE_OUTPUT_PER_1M=15

# Необязательно: валюта для сумм из LLM_PRICE_*_PER_1M выше. Если не задано — "$".
# LLM_PRICE_CURRENCY=$
